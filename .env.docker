# =============================================================================
# Docker Environment — Copy to .env.docker and fill in actual values
# =============================================================================

# Backend — Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# Backend — SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Backend — Scraper
WORKGO_COOKIE=
PROXY_URL=
LOG_LEVEL=INFO

# Backend — App
DEBUG=false
CORS_ORIGINS=["http://localhost","http://localhost:80"]

# Frontend (build-time, also set as build args in docker-compose.yml)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
